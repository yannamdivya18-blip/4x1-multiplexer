`timescale 1ns/1ps

module mux4x1_tb;

reg I0;
reg I1;
reg I2;
reg I3;
reg S0;
reg S1;

wire Y;

// Instantiate DUT
mux4x1 uut (
    .I0(I0),
    .I1(I1),
    .I2(I2),
    .I3(I3),
    .S0(S0),
    .S1(S1),
    .Y(Y)
);

initial
begin

    $display("Time\tS1 S0\tI3 I2 I1 I0\tY");
    $monitor("%0t\t%b  %b\t%b  %b  %b  %b\t%b",
             $time,S1,S0,I3,I2,I1,I0,Y);

    // Inputs
    I0=0; I1=1; I2=0; I3=1;

    S1=0; S0=0;
    #10;

    S1=0; S0=1;
    #10;

    S1=1; S0=0;
    #10;

    S1=1; S0=1;
    #10;

    // Change inputs
    I0=1; I1=0; I2=1; I3=0;

    S1=0; S0=0;
    #10;

    S1=0; S0=1;
    #10;

    S1=1; S0=0;
    #10;

    S1=1; S0=1;
    #10;

    $finish;

end

endmodule